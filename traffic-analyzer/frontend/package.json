{
  "name": "traffic-analyzer-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React + TypeScript frontend for the Python-based HTTP/HTTPS traffic analyzer (contract v1)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
